# SnapDispatch pilot checkpoint. Placeholder names only. Do not commit real secrets.

# development | test | staging | production
# Fixture reset refuses to run when this is production.
# Hosted staging must use staging so the fixture-password rules and access gate apply.
SNAPDISPATCH_ENV=development

# Postgres for the pilot database. Use a project that holds no customer data.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/snapdispatch

# Signs session cookies. Required for staging and production.
# Use a long random string of at least 16 characters. Never commit the real value.
PILOT_SESSION_SECRET=

# Shared password hashed into synthetic pilot_credentials by pilot:reset.
# Development and test only: if unset, reset uses the local default synthetic-dev-password.
# Staging refuses an empty value, a value shorter than 16 characters, and synthetic-dev-password.
# Do not put a staging password in this file. Setting this does not create Supabase Auth users.
PILOT_FIXTURE_PASSWORD=synthetic-dev-password

# When SNAPDISPATCH_ENV=staging and this is non-empty, /app and /api/v1 stay locked
# until the browser unlocks at /staging-access (cookie sd_staging), or the request
# sends header x-staging-access or an HTTP Basic password equal to this code.
# Leave unset in development and test. The public pitch at / is never gated.
# Never commit the real value.
STAGING_ACCESS_CODE=

# Private files used when Supabase Storage is not configured.
PILOT_STORAGE_DIR=.pilot-storage

# Hosted staging storage. Server-only. Leave blank to use the local directory.
# SUPABASE_URL is the project URL (https://<ref>.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY must never use a NEXT_PUBLIC_ prefix.
# SUPABASE_STORAGE_BUCKET defaults to load-files and must be a private bucket.
# Do not set NEXT_PUBLIC_SUPABASE_ANON_KEY or SUPABASE_JWT_SECRET for the
# password-session staging path. Those do not create logins.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=load-files
